# Local development only.
# Copy to .env and change credentials if this machine is shared.
# Never use these values in staging or production.

POSTGRES_DB=bff
POSTGRES_USER=bff
POSTGRES_PASSWORD=bff_local_only_change_me
POSTGRES_PORT=5432

BFF_DATABASE_URL=postgresql+asyncpg://bff:bff_local_only_change_me@127.0.0.1:5432/bff
BFF_MIGRATION_DATABASE_URL=postgresql+psycopg://bff:bff_local_only_change_me@127.0.0.1:5432/bff

BFF_SERVICE_NAME=bff-control
BFF_ENVIRONMENT=dev
BFF_TELEMETRY_ENABLED=true
BFF_OTEL_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces

# AuthKit / OIDC verification.
# These defaults match WorkOS AuthKit without a custom authentication domain.
# If a custom auth domain is introduced, use its exact issuer/JWKS contract.
BFF_AUTH_ISSUER=https://api.workos.com/user_management/client_replace_me
BFF_AUTH_CLIENT_ID=client_0********
BFF_AUTH_JWKS_URL=https://api.workos.com/sso/jwks/client_replace_me
BFF_AUTH_JWKS_CACHE_TTL_SECONDS=300
BFF_AUTH_JWKS_REQUEST_TIMEOUT_SECONDS=5
BFF_AUTH_JWKS_UNKNOWN_KID_COOLDOWN_SECONDS=30
BFF_AUTH_JWT_LEEWAY_SECONDS=30
BFF_AUTH_MAX_BEARER_TOKEN_LENGTH=16384
BFF_AUTH_SESSION_ABSOLUTE_TTL_SECONDS=604800

# Server-side WorkOS User lookup.
BFF_WORKOS_API_KEY=sk_replace_me
BFF_WORKOS_API_BASE_URL=https://api.workos.com
BFF_WORKOS_USER_REQUEST_TIMEOUT_SECONDS=5

RABBITMQ_DEFAULT_USER=bff
RABBITMQ_DEFAULT_PASS=bff_local_only_change_me
RABBITMQ_DEFAULT_VHOST=/
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

VALKEY_PASSWORD=bff_local_only_change_me
VALKEY_PORT=6379

OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_HEALTH_PORT=13133

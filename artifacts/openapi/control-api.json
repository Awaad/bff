{
  "components": {
    "schemas": {
      "CreateWorkspaceRequest": {
        "properties": {
          "name": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "CreateWorkspaceRequest",
        "type": "object"
      },
      "LivenessResponse": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "LivenessResponse",
        "type": "object"
      },
      "MeResponse": {
        "properties": {
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "display_name"
        ],
        "title": "MeResponse",
        "type": "object"
      },
      "ProblemCode": {
        "description": "Stable machine-readable public problem codes.",
        "enum": [
          "AUTH_INVALID_CREDENTIALS",
          "AUTH_EMAIL_VERIFICATION_REQUIRED",
          "AUTH_ACCOUNT_LINK_REQUIRED",
          "AUTH_PROVIDER_UNAVAILABLE",
          "WORKSPACE_NOT_FOUND",
          "REQUEST_VALIDATION_FAILED",
          "REQUEST_NOT_FOUND",
          "REQUEST_METHOD_NOT_ALLOWED",
          "REQUEST_REJECTED",
          "INTERNAL_ERROR"
        ],
        "title": "ProblemCode",
        "type": "string"
      },
      "ProblemDetail": {
        "description": "RFC 9457 problem plus stable BFF extensions.",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ProblemCode"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ValidationIssue"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errors"
          },
          "instance": {
            "title": "Instance",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "retryable": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Retryable"
          },
          "status": {
            "maximum": 599.0,
            "minimum": 100.0,
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "code",
          "request_id"
        ],
        "title": "ProblemDetail",
        "type": "object"
      },
      "ProvisionedUserResponse": {
        "properties": {
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "display_name"
        ],
        "title": "ProvisionedUserResponse",
        "type": "object"
      },
      "ReadinessResponse": {
        "properties": {
          "status": {
            "enum": [
              "ready",
              "not_ready"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      },
      "SessionProvisioningResponse": {
        "properties": {
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/ProvisionedUserResponse"
          }
        },
        "required": [
          "user",
          "expires_at"
        ],
        "title": "SessionProvisioningResponse",
        "type": "object"
      },
      "ValidationIssue": {
        "description": "One safe request-validation issue.",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ValidationIssueCode"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "pointer": {
            "title": "Pointer",
            "type": "string"
          }
        },
        "required": [
          "pointer",
          "code",
          "detail"
        ],
        "title": "ValidationIssue",
        "type": "object"
      },
      "ValidationIssueCode": {
        "description": "Stable machine-readable validation issue codes.",
        "enum": [
          "REQUIRED",
          "INVALID_JSON",
          "INVALID_VALUE"
        ],
        "title": "ValidationIssueCode",
        "type": "string"
      },
      "WorkspaceListResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/WorkspaceResponse"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "WorkspaceListResponse",
        "type": "object"
      },
      "WorkspaceResponse": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/WorkspaceRole"
          },
          "status": {
            "$ref": "#/components/schemas/WorkspaceStatus"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "status",
          "role",
          "created_at",
          "updated_at"
        ],
        "title": "WorkspaceResponse",
        "type": "object"
      },
      "WorkspaceRole": {
        "enum": [
          "OWNER",
          "ADMIN",
          "BUILDER",
          "VIEWER"
        ],
        "title": "WorkspaceRole",
        "type": "string"
      },
      "WorkspaceStatus": {
        "enum": [
          "ACTIVE",
          "SUSPENDED",
          "ARCHIVED",
          "PENDING_DELETION"
        ],
        "title": "WorkspaceStatus",
        "type": "string"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Backend for Framer Control API",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",

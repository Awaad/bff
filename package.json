{
  "name": "backend-for-framer",
  "private": true,
  "packageManager": "pnpm@12.4.0",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "boundaries": "uv run python scripts/check_python_boundaries.py && node scripts/check_ts_boundaries.mjs",
    "check": "turbo run check",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "contract:generate": "pnpm --filter @bff/api-contract generate",
    "contract:check": "pnpm --filter @bff/api-contract check",
    "format": "prettier --write . && uv run ruff format .",
    "format:check": "prettier --check . && uv run ruff format --check ."
  },
  "devDependencies": {
    "es-module-lexer": "3.0.2",
    "prettier": "3.9.0",
    "turbo": "2.10.6",
    "typescript": "7.0.2"
  },
  "license": "UNLICENSED"
}
